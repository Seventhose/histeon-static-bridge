msgstr "Install the Nginx block shown in Settings, include the current dynamic paths and reload Nginx; then repeat the diagnostics."

#: static-bridge.php:8127
msgid "Blocco Static Bridge assente, incompleto o posizionato dopo le regole WordPress."
msgstr "Static Bridge block missing, incomplete or placed after the WordPress rules."

#: static-bridge.php:8127
