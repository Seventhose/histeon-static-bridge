#. Plugin Name of the plugin
#: static-bridge.php static-bridge.php:382 static-bridge.php:1095 static-bridge.php:1096 static-bridge.php:1116
msgid "Static Bridge"
msgstr "Static Bridge"

#: static-bridge.php:25
msgid "Static Bridge è già in funzione su questo sito, come modulo di Histeon o da un’altra cartella dei plugin. Spegni prima quello (per Histeon: il modulo Static Bridge nelle sue impostazioni), poi attiva questo plugin."
msgstr "Static Bridge is already running on this site, as the Histeon module or from another plugin folder. Turn that one off first (for Histeon: the Static Bridge module in its settings), then activate this plugin."

#: static-bridge.php:26
msgid "Static Bridge è già in funzione"
msgstr "Static Bridge is already running"

#: static-bridge.php:3282
msgid "Nessun redirect importato nelle regole del server."
msgstr "No imported redirect in the server rules."

#: static-bridge.php:10965
msgid "Blocco Nginx in uso"
msgstr "Nginx block in use"

#: static-bridge.php:10966
msgid "Copia di nuovo il blocco Nginx da Impostazioni al posto di quello che c’è sul server, ricarica Nginx e ripeti la Diagnostica."
msgstr "Copy the Nginx block from Settings again in place of the one on the server, reload Nginx and run the Diagnostics again."

#: static-bridge.php:10970
msgid "Nginx non serve ancora la copia statica: questo controllo si fa quando passa il passo «Regole del server web»."
msgstr "Nginx does not serve the static copy yet: this check runs once the “Web server rules” step passes."

#: static-bridge.php:10975
msgid "Nginx serve la copia con un blocco di una versione precedente di Static Bridge: non si può sapere se segue le Impostazioni di adesso."
msgstr "Nginx serves the copy with a block from an earlier version of Static Bridge: there is no way to know whether it follows the current Settings."

#: static-bridge.php:10979
msgid "Nginx usa il blocco che corrisponde alle Impostazioni di adesso, redirect compresi."
msgstr "Nginx uses the block that matches the current Settings, redirects included."

#: static-bridge.php:10985
msgid "Le Impostazioni sono cambiate dopo l’ultima copia del blocco Nginx, per esempio un’opzione accesa o spenta: il server segue ancora le regole di prima."
msgstr "The Settings changed after the Nginx block was last copied, for example an option turned on or off: the server still follows the old rules."

#: static-bridge.php:10989
msgid "Nel blocco Nginx in uso mancano i redirect di adesso, importati da un altro plugin o dati con il filtro static_bridge_redirects."
msgstr "The Nginx block in use lacks the current redirects, imported from another plugin or given with the static_bridge_redirects filter."

#: static-bridge.php:10991
msgid "Il blocco Nginx in uso fa ancora dei redirect che adesso non ci sono più."
msgstr "The Nginx block in use still makes redirects that no longer exist."

#: static-bridge.php:10993
msgid "I redirect sono cambiati dopo l’ultima copia del blocco Nginx, per esempio quelli importati da un altro plugin: il server fa ancora quelli di prima."
msgstr "The redirects changed after the Nginx block was last copied, for example the ones imported from another plugin: the server still makes the old ones."

#. Description of the plugin
#: static-bridge.php
msgid "Serve pagine WordPress pubblicate come HTML statico sullo stesso dominio mantenendo wp-admin dinamico."
msgstr "Serves published WordPress pages as static HTML on the same domain, keeping wp-admin dynamic."

#: object-cache.php:43
msgid "Non disponibile su multisite."
msgstr "Not available on multisite."

#: object-cache.php:46 object-cache.php:139
msgid "C’è già un file object-cache.php di un altro plugin o dell’hosting: Static Bridge non lo sostituisce."
msgstr "There is already an object-cache.php file from another plugin or from the hosting provider: Static Bridge does not replace it."

#: object-cache.php:49
msgid "Né Redis né Memcached rispondono su questo server."
msgstr "Neither Redis nor Memcached answers on this server."

#: object-cache.php:52
msgid "WordPress non può scrivere nella cartella wp-content."
msgstr "WordPress cannot write to the wp-content folder."

#: object-cache.php:103
msgid "Il modello del drop-in non è leggibile."
msgstr "The drop-in template cannot be read."

#: object-cache.php:125
msgid "Il file object-cache.php non è di Static Bridge: resta dov’è."
msgstr "The object-cache.php file is not Static Bridge’s: it stays where it is."

#: object-cache.php:128
msgid "Il file object-cache.php non si può togliere: toglilo a mano da wp-content."
msgstr "The object-cache.php file cannot be removed: remove it by hand from wp-content."

#: object-cache.php:144 object-cache.php:149
msgid "Scrittura di object-cache.php non riuscita."
msgstr "Writing object-cache.php failed."

#. translators: %s: error message
#, php-format
#: object-cache.php:178
msgid "Il sito non ha risposto alla prova della cache: %s. Il drop-in è stato tolto."
msgstr "The site did not answer the cache test: %s. The drop-in has been removed."

#. translators: %s: HTTP status code
#, php-format
#: object-cache.php:187
msgid "Con il drop-in il sito ha risposto HTTP %s: il drop-in è stato tolto e il sito è tornato com’era."
msgstr "With the drop-in the site answered HTTP %s: the drop-in has been removed and the site is back as it was."

#: object-cache.php:192
msgid "Il drop-in si è caricato ma non è riuscito a collegarsi al servizio: è stato tolto."
msgstr "The drop-in loaded but could not connect to the service: it has been removed."

#: release-updater.php:169
msgid "Aggiornamento di Static Bridge fermato: il pacchetto non è più l’ultima release firmata. Controlla di nuovo gli aggiornamenti."
msgstr "Static Bridge update stopped: the package is no longer the latest signed release. Check for updates again."

#: release-updater.php:181
msgid "Pacchetto troppo grande."
msgstr "Package too large."

#: release-updater.php:185
msgid "Firma della release non scaricata."
msgstr "The release signature could not be downloaded."

#: release-updater.php:191
msgid "La firma è di un altro pacchetto."
msgstr "The signature is for another package."

#. translators: %s: reason
#, php-format
#: release-updater.php:196
msgid "Aggiornamento di Static Bridge fermato: %s"
msgstr "Static Bridge update stopped: %s"

#: release-updater.php:209
msgid "Chiave pubblica minisign non valida."
msgstr "Invalid minisign public key."

#: release-updater.php:214
msgid "Firma troppo lunga."
msgstr "Signature too long."

#: release-updater.php:218 release-updater.php:223
msgid "Firma minisign illeggibile."
msgstr "Unreadable minisign signature."

#: release-updater.php:226
msgid "Algoritmo di firma sconosciuto."
msgstr "Unknown signature algorithm."

#: release-updater.php:229
msgid "Firmato con un’altra chiave."
msgstr "Signed with another key."

#: release-updater.php:233
msgid "La firma non corrisponde al file."
msgstr "The signature does not match the file."

#: release-updater.php:237
msgid "Il commento firmato è stato alterato."
msgstr "The signed comment has been altered."

#: release-updater.php:246
msgid "File da verificare non leggibile."
msgstr "The file to verify cannot be read."

