msgstr "The site answers HTTP 401 even with the credentials of wp-config.php: wrong user name or password."

#: static-bridge.php:9819
msgid "Correggi in wp-config.php le costanti con il nome utente e la password del web server."
msgstr "Correct the constants in wp-config.php with the web server's user name and password."

#. translators: %s: HTTP status code
#, php-format
#: static-bridge.php:9825
msgid "Basic Auth attiva: senza credenziali il sito risponde HTTP 401, con le credenziali di wp-config.php HTTP %s."
msgstr "Basic Auth on: without credentials the site answers HTTP 401, with the credentials of wp-config.php HTTP %s."

