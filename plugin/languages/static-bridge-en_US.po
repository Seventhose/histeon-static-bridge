#, php-format
#: static-bridge.php:7967
msgid "Parità non verificata mentre è in corso un export: file %1$s, pubblico %2$s. Il rendering WordPress fresco è stato saltato per non interferire con il job."
msgstr "Parity not verified while an export is running: file %1$s, public %2$s. The fresh WordPress rendering was skipped so as not to interfere with the job."

#. translators: 1: fingerprint of the release file, 2: fingerprint of the public response
#: static-bridge.php:7968
msgid "Attendi il completamento o l’arresto del job e ripeti la diagnostica."
msgstr "Wait for the job to complete or stop and repeat the diagnostics."

