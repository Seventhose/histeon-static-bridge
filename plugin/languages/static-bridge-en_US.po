msgstr "The .htaccess file lacks the Static Bridge probe rule for OpenLiteSpeed."

#: static-bridge.php:15971
msgid "Usa solo direttive Cache-Control standard separate da virgole, ad esempio \"public, max-age=0, s-maxage=600\". Sono ammesse: public, no-cache, no-store, no-transform, must-revalidate, proxy-revalidate, immutable, max-age, s-maxage, stale-while-revalidate, stale-if-error."
msgstr "Use only standard Cache-Control directives separated by commas, for example \"public, max-age=0, s-maxage=600\". Allowed: public, no-cache, no-store, no-transform, must-revalidate, proxy-revalidate, immutable, max-age, s-maxage, stale-while-revalidate, stale-if-error."

